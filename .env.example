# Supabase — bkz. .env (bu proje için zaten dolu)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — Destek Asistanı ve Doğruluk Kontrolcüsü ajanları için (ücretsiz kota).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# İsteğe bağlı model override'ları (boş bırakılırsa gemini-flash-latest kullanılır)
GEMINI_CHAT_MODEL=
GEMINI_FACT_CHECK_MODEL=
GEMINI_EMBEDDING_MODEL=

# Firecrawl — Doğruluk Kontrolcüsü'nün web'den kaynak taraması için.
# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Apify — Google Maps Scraper ile gerçek usta/sanayi verisi içe aktarmak için (admin panel).
# https://console.apify.com/account/integrations
APIFY_API_TOKEN=
